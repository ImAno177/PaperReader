<resources>
    <style name="Theme.PaperReader" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">#1C293C</item>
        <item name="android:navigationBarColor">#FBFBF9</item>
        <item name="android:statusBarColor">#FBFBF9</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.PaperReader.PdfReader" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/reader_canvas</item>
        <item name="android:navigationBarColor">@color/reader_canvas</item>
        <item name="android:statusBarColor">@color/reader_canvas</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="colorPrimary">@color/reader_ink</item>
        <item name="colorOnPrimary">@color/reader_canvas</item>
        <item name="colorSecondary">@color/reader_accent</item>
        <item name="colorOnSecondary">@color/reader_on_accent</item>
        <item name="colorSurface">@color/reader_canvas</item>
        <item name="colorOnSurface">@color/reader_ink</item>
        <item name="colorSurfaceVariant">@color/reader_surface</item>
        <item name="colorOnSurfaceVariant">@color/reader_ink_muted</item>
    </style>

    <style name="Theme.PaperReader.PdfReader.Neobrutalism" parent="Theme.PaperReader.PdfReader">
        <item name="android:windowBackground">@color/reader_neo_canvas</item>
        <item name="android:navigationBarColor">@color/reader_neo_canvas</item>
        <item name="android:statusBarColor">@color/reader_neo_canvas</item>
        <item name="colorPrimary">@color/reader_neo_border</item>
        <item name="colorOnPrimary">@color/reader_neo_on_secondary</item>
        <item name="colorSecondary">@color/reader_neo_primary</item>
        <item name="colorOnSecondary">@color/reader_neo_on_primary</item>
        <item name="colorSurface">@color/reader_neo_surface</item>
        <item name="colorOnSurface">@color/reader_neo_ink</item>
        <item name="colorSurfaceVariant">@color/reader_neo_surface_muted</item>
        <item name="colorOnSurfaceVariant">@color/reader_neo_ink_muted</item>
        <item name="colorOutline">@color/reader_neo_border</item>
    </style>
</resources>
