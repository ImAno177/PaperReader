<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp"
    android:paddingBottom="4dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/readable_reader_text_size_label"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:textColor="?attr/colorOnSurface" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/readable_layout_text_decrease"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="80dp"
            android:layout_height="48dp"
            android:contentDescription="@string/readable_reader_text_smaller"
            android:minWidth="48dp"
            android:paddingHorizontal="8dp"
            android:singleLine="true"
            android:text="@string/readable_reader_text_smaller_short" />

        <TextView
            android:id="@+id/readable_layout_text_value"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginHorizontal="8dp"
            android:layout_weight="1"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurface" />

        <Button
            android:id="@+id/readable_layout_text_increase"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="80dp"
            android:layout_height="48dp"
            android:contentDescription="@string/readable_reader_text_larger"
            android:minWidth="48dp"
            android:paddingHorizontal="8dp"
            android:singleLine="true"
            android:text="@string/readable_reader_text_larger_short" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/readable_reader_spacing"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:textColor="?attr/colorOnSurface" />

    <RadioGroup
        android:id="@+id/readable_layout_spacing_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/readable_layout_spacing_compact"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/readable_reader_spacing_compact" />

        <RadioButton
            android:id="@+id/readable_layout_spacing_comfortable"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/readable_reader_spacing_comfortable" />

        <RadioButton
            android:id="@+id/readable_layout_spacing_relaxed"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/readable_reader_spacing_relaxed" />
    </RadioGroup>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/readable_reader_side_margins"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:textColor="?attr/colorOnSurface" />

    <RadioGroup
        android:id="@+id/readable_layout_margin_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/readable_layout_margin_narrow"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/readable_reader_margin_narrow" />

        <RadioButton
            android:id="@+id/readable_layout_margin_comfortable"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/readable_reader_margin_comfortable" />

        <RadioButton
            android:id="@+id/readable_layout_margin_wide"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/readable_reader_margin_wide" />
    </RadioGroup>
</LinearLayout>
