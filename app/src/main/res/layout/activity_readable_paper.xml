<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/readable_reader_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/readable_reader_toolbar"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="?attr/colorSurface"
        android:minHeight="72dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        app:contentInsetEndWithActions="4dp"
        app:contentInsetStartWithNavigation="4dp"
        app:subtitleTextColor="?attr/colorOnSurfaceVariant"
        app:titleTextColor="?attr/colorOnSurface" />

    <LinearLayout
        android:id="@+id/readable_reader_find_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="4dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/readable_reader_find_query"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/readable_reader_search_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:minHeight="48dp"
            android:selectAllOnFocus="false"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/readable_reader_find_result"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:minWidth="56dp"
            android:paddingHorizontal="4dp"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <ImageButton
            android:id="@+id/readable_reader_find_previous"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/readable_reader_search_previous"
            android:enabled="false"
            android:padding="12dp" />

        <ImageButton
            android:id="@+id/readable_reader_find_next"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/readable_reader_search_next"
            android:enabled="false"
            android:padding="12dp" />

        <ImageButton
            android:id="@+id/readable_reader_find_close"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/readable_reader_search_close"
            android:padding="12dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/readable_reader_provenance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceVariant"
        android:ellipsize="end"
        android:maxLines="4"
        android:minHeight="44dp"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp"
        android:textAppearance="?attr/textAppearanceLabelMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="?attr/colorSurfaceVariant">

        <dev.paperreader.app.reader.ReadablePaperWebView
            android:id="@+id/readable_reader_webview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="yes"
            android:visibility="invisible" />

        <ImageButton
            android:id="@+id/readable_reader_citation_return"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/readable_reader_citation_return"
            android:elevation="8dp"
            android:importantForAccessibility="yes"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:padding="16dp"
            android:scaleType="center"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/readable_reader_loading"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:contentDescription="@string/readable_reader_loading"
            android:indeterminate="true" />

        <LinearLayout
            android:id="@+id/readable_reader_error"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/readable_reader_error_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/readable_reader_failed_title"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/readable_reader_error_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textAppearance="?attr/textAppearanceBodyLarge" />

            <Button
                android:id="@+id/readable_reader_retry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:minHeight="48dp"
                android:text="@string/retry" />

            <Button
                android:id="@+id/readable_reader_original_pdf"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="@string/readable_reader_open_original" />
        </LinearLayout>

    </FrameLayout>
</LinearLayout>
